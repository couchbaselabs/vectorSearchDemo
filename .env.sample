## Couchbase connection
COUCHBASE_CONNSTR=couchbases://connectionstring
COUCHBASE_USERNAME=username
COUCHBASE_PASSWORD=password

# dimensions — must match your embedding model AND the collection's vector index.
# Supported combinations (model -> dimension):
#   all-MiniLM-L6-v2 (local)            -> 384
#   text-embedding-3-small (OpenAI)     -> 1536
#   text-embedding-3-large (OpenAI)     -> 3072
# If unset, the scripts derive the dimension from the chosen model for known models, or you can
# pass --dimensions N. Precedence: --dimensions > VECTOR_DIMENSIONS > derived-from-model.
VECTOR_DIMENSIONS=384 # for sentence transformer
# VECTOR_DIMENSIONS=1536 # for OpenAI text-embedding-3-small

## Embedding provider: OpenAI (preferred) or local sentence-transformers
## OpenAI is REQUIRED for RAG programs, but not for load.py
## By default the provider is inferred from this file: SENTENCE_TRANSFORMER_MODEL set below
## selects local (384-dim); comment it out to use OpenAI (1536-dim). You can override per-run
## on load.py / rag*.py with --embedding-provider {local,openai}. Whichever you pick, its
## dimension (local=384, OpenAI=1536) must match the target collection's vector index.
# To use OpenAI embeddings, set OPENAI_API_KEY and optionally model
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini

# If you prefer local embeddings, optionally set a model name for sentence-transformers
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
CUDA_VISIBLE_DEVICES=

# Optional HuggingFace token. The scripts run HF fully offline by default (model weights are
# cached locally) to avoid per-run cache-revalidation rate-limiting. Set HF_TOKEN only if you
# genuinely want authenticated online HF access (e.g. to download a new/gated model) — when set,
# the scripts stop forcing offline mode.
# HF_TOKEN=hf_...

## -----------------------------------------------------------------------------
## Agent Memory (Phase 2 — AI Data Plane). Optional; only needed for the AI Data
## Plane features. See README "Set up Agent Memory".
## -----------------------------------------------------------------------------
## Where the app reaches the agent-memory server. Host port 8090 by default because app.py
## already uses 8080. Repoint to the Capella-hosted endpoint when it's available.
AGENT_MEMORY_BASE_URL=http://localhost:8090

## The variables below configure the agent-memory Docker CONTAINER (passed via --env-file),
## not the Python scripts. Mirror your Couchbase credentials above. The container also makes
## its own OpenAI calls for memory embeddings/extraction, so it reuses OPENAI_API_KEY.
# AGENTMEMORY_CONN_STRING=couchbases://cb.xxxxxxxx.cloud.couchbase.com
# AGENTMEMORY_USERNAME=your-db-user
# AGENTMEMORY_PASSWORD=your-db-password
# AGENTMEMORY_BUCKET=vectorSearchDemo
# AGENTMEMORY_EMBEDDING_MODEL=text-embedding-3-small
# AGENTMEMORY_LLM_MODEL=gpt-4o-mini